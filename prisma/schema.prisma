generator client {
  provider = "prisma-client-js"
}

enum GithubConfidence {
  high
  low
  insufficient
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String            @id @default(uuid())
  githubId            String            @unique
  username            String            @unique
  email               String?
  name                String?
  avatarUrl           String?
  bio                 String?
  commitmentScore     Float             @default(0)
  githubAccessToken   String?           // AES-256-GCM encrypted
  contextNote         String?           // User-authored note shown on public profile, does NOT affect score
  latitude            Float?            // City-level, for proximity-based hackathon discovery
  longitude           Float?            // City-level, for proximity-based hackathon discovery
  roleTags            String[]          @default([]) // Backend, Frontend, Mobile, AI/ML, Design/UI, Product/PM, DevOps
  primaryStack        String?           // e.g. "Node.js, TypeScript, NestJS"
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  githubMetrics       GithubMetrics?
  interviewSession    InterviewSession?
  commitmentScore_rel CommitmentScore?
  submittedHackathons Hackathon[]       @relation("SubmittedHackathons")
  hackathonVouches    HackathonVouch[]  @relation("HackathonVouches")
  hackathonReports    HackathonReport[] @relation("HackathonReports")
  hackathonJoins      HackathonJoin[]   @relation("HackathonJoins")
  createdTeams        Team[]            @relation("CreatedTeams")
  teamMemberships     TeamMember[]
  sentInvites         TeamInvite[]      @relation("SentInvites")
  receivedInvites     TeamInvite[]      @relation("ReceivedInvites")
  givenRatings        Rating[]          @relation("GivenRatings")
  receivedRatings     Rating[]          @relation("ReceivedRatings")
  notifications       Notification[]

  @@map("users")
}

model GithubMetrics {
  id                     String            @id @default(uuid())
  userId                 String            @unique
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                 String            @default("pending")  // pending | processing | complete | insufficient_data | failed
  githubConsistencyScore Float?
  repoBreakdown          Json?
  githubConfidence       GithubConfidence  @default(insufficient)  // high | low | insufficient
  accountCreatedAt       DateTime?         // GitHub account creation date, fetched once during sync
  qualifyingRepoCount    Int               @default(0)
  totalCommitCount       Int               @default(0)
  errorReason            String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@map("github_metrics")
}

model InterviewSession {
  id               String   @id @default(uuid())
  userId           String   @unique           // one active session per user at a time
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String   @default("in_progress") // in_progress | complete | failed
  transcriptJson   Json     @default("[]")    // TranscriptEntry[]
  structuredOutput Json?                      // InterviewAnalysis on completion
  bioSummary       String?  // Populated from dedicated early interview question about the user's background
  errorReason      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("interview_sessions")
}

model CommitmentScore {
  id                           String   @id @default(uuid())
  userId                       String   @unique
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubScore                  Float                  // raw 0-100 from github_metrics
  interviewScore               Float                  // specificity_score 0-100 from interview
  commitmentScore              Float                  // weighted composite (dynamic weights)
  appliedGithubWeight          Float    @default(0.7) // actual weight used for this user (varies by confidence)
  appliedInterviewWeight       Float    @default(0.3) // actual weight used for this user
  declaredHoursPerDay          Float?
  flaggedDiscrepancies         Json?                  // Array<{repo, issue, userExplanation}>
  cappedDiscrepancyAdjustments Json?                  // Array<{repo, issue, originalWeight, reductionApplied, cappedAt}>
  discrepancyResolutionPattern Float?                 // ratio: explained / flagged (0-1, null if no flags)
  communicationNotes           String?
  scoreExplanationSummary      String?                // AI-generated plain-language paragraph explaining the score
  peerRatingScore              Float?
  peerWeight                   Float    @default(0)
  appliedPeerWeight            Float    @default(0)
  distinctTeamsRated           Int      @default(0)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("commitment_scores")
}

// ─── Hackathons ───────────────────────────────────────────────────────────────

model Hackathon {
  id                 String    @id @default(uuid())
  title              String
  logoUrl            String?
  description        String?   // legacy short description (OG-only), kept for backwards compat

  // ── AI-extracted rich fields ───────────────────────────────────────────────
  shortDescription    String?  // concise blurb AI extracted (Path A/B)
  fullDescription     String?  // full event body text AI extracted
  eligibility         String?  // who can participate, AI extracted
  teamSize            String?  // e.g. "2–4 members", AI extracted
  prizePoolTotal      String?  // stored as-written: "₦1,000,000" — never parsed to number
  prizeBreakdown      Json?    // JSON array of {place, prize} — only if source categorizes it
  applicationDeadline DateTime? // separate from submissionDeadline; AI-extracted
  extractionSource    String   @default("manual") // 'url' | 'image' | 'manual'
  rawSourceText       String?  // page text (URL) or OCR transcript (image) — admin-only
  imageUrl            String?  // stored flyer image path for image submissions — admin-only

  startDate          DateTime?
  endDate            DateTime?
  submissionDeadline DateTime?
  venueType          String   @default("virtual")  // physical | virtual | hybrid
  locationLabel      String?                        // city-level label, e.g. "Lagos, Nigeria"
  latitude           Float?                         // city-level precision
  longitude          Float?                         // city-level precision
  externalUrl        String?                        // nullable: image submissions may not have a link yet
  prizeInfo          String?                        // display-only legacy field, NOT transactional
  tags               String[] @default([])
  status             String   @default("pending")   // pending | verified | flagged
  submittedBy        String
  submitter          User     @relation("SubmittedHackathons", fields: [submittedBy], references: [id])
  trustScore         Float    @default(0)           // computed from vouches/reports
  createdAt          DateTime @default(now())

  vouches  HackathonVouch[]
  reports  HackathonReport[]
  joins    HackathonJoin[]
  teams    Team[]
  invites  TeamInvite[]

  @@map("hackathons")
}

model HackathonVouch {
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("HackathonVouches", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([hackathonId, userId])
  @@map("hackathon_vouches")
}

model HackathonReport {
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("HackathonReports", fields: [userId], references: [id], onDelete: Cascade)
  reason      String
  createdAt   DateTime  @default(now())

  @@id([hackathonId, userId])
  @@map("hackathon_reports")
}

model HackathonJoin {
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("HackathonJoins", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@id([hackathonId, userId])
  @@map("hackathon_joins")
}

// ─── Team Matching & Invites ───────────────────────────────────────────────────

model Team {
  id          String       @id @default(uuid())
  hackathonId String
  hackathon   Hackathon    @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User         @relation("CreatedTeams", fields: [creatorId], references: [id], onDelete: Cascade)
  targetSize  Int          @default(4)
  status      String       @default("forming") // forming | complete
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
  invites     TeamInvite[]
  ratings     Rating[]

  @@map("teams")
}

model TeamMember {
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([teamId, userId])
  @@map("team_members")
}

model TeamInvite {
  id          String    @id @default(uuid())
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User      @relation("SentInvites", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User      @relation("ReceivedInvites", fields: [toUserId], references: [id], onDelete: Cascade)
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  charterJson Json?     // AI-generated team charter draft for this pair match
  status      String    @default("pending") // pending | accepted | declined
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("team_invites")
}

model Rating {
  id                 String    @id @default(uuid())
  teamId             String
  team               Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  raterId            String
  rater              User      @relation("GivenRatings", fields: [raterId], references: [id], onDelete: Cascade)
  rateeId            String
  ratee              User      @relation("ReceivedRatings", fields: [rateeId], references: [id], onDelete: Cascade)
  deliveredScore     Int
  communicationScore Int
  wouldWorkAgain     Boolean
  comment            String?
  visibleAt          DateTime?
  createdAt          DateTime  @default(now())

  @@unique([teamId, raterId, rateeId])
  @@map("ratings")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}


